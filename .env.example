# From Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
# Publishable (anon) key. Safe for the browser; protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used for auth redirect links, e.g. http://localhost:3000 locally or your Vercel URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only (needed ONLY for the RLS integration tests, never for the app, never NEXT_PUBLIC_):
# SUPABASE_SERVICE_ROLE_KEY=
